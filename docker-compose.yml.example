services:
  gymdl:
    platform: linux/amd64
    image: ghcr.io/nichuanfang/gymdl:latest
    container_name: gymdl
    environment:
      - PUID=1000
      - PGID=1000
      # Allows Settings to request a graceful container restart; keep restart policy enabled below.
      - GYMDL_WEBUI_RESTART_ENABLED=true
    volumes:
     #必须挂载配置文件否则项目无法启动
      - ./config.yaml:/app/config.yaml
      # 持久化全部运行数据（SQLite、历史、下载目录、日志、临时文件等）
      - ./data:/app/data
      # pip 缓存目录
      - ./.pipcache:/root/.cache/pip
    expose:
      #api端口
      - 8080
      #webhook监听的端口 跟配置文件的保持一致      
      - 9000
    networks:
      - mynet
    restart: always

networks:
  mynet:
    external: true
